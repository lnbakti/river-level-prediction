# ==============================================================================
# Environment Configuration Template for Water Level Early Warning System
# ==============================================================================
# Salin file ini menjadi `.env` dan sesuaikan dengan konfigurasi sistem Anda.
# PENTING: Jangan commit file `.env` yang berisi kredensial produksi ke GitHub!

# === Database Configuration (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=db_waterlevel

# === Backend / API Configuration ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Water Level Early Warning System API"

# === Machine Learning Service URL ===
ML_API_URL=http://127.0.0.1:8001/predict

# === WhatsApp Gateway (Fonnte API) ===
# Dapatkan token API dari dashboard https://fonnte.com/
FONNTE_API_KEY=your_fonnte_api_key_here

# === Security / Authentication ===
# Gunakan string acak yang kuat untuk JWT secret
SECRET_KEY=generate_a_random_secret_key_here
